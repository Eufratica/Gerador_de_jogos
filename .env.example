# PlayForge Factory — Variaveis Locais de Desenvolvimento (Zero Secrets)
# Copie para .env (ignorado pelo Git) via:
#   ./infrastructure/scripts/playforge.sh env-init
#   ou .\infrastructure\scripts\playforge.ps1 env-init

COMPOSE_PROJECT_NAME=playforge

# Portas publicadas apenas em 127.0.0.1 (sem conflito com 5433, 5678, 6333, 6334, 6380, 8000, 1880)
PLAYFORGE_PG_PORT=5434
PLAYFORGE_VALKEY_PORT=6381

# Banco local de desenvolvimento (somente container local; NUNCA usar em producao)
POSTGRES_DB=playforge
POSTGRES_USER=playforge
POSTGRES_PASSWORD=playforge_local_dev

# Toolchain fixada (Fase 1)
GODOT_VERSION=4.4-stable
